{
  "framework": "nextjs",
  "ignoreCommand": "P=$VERCEL_GIT_PREVIOUS_SHA; if [ -n \"$P\" ] && { git cat-file -e \"$P^{commit}\" 2>/dev/null || git fetch -q --deepen=300 origin; } && git diff --quiet \"$P\" HEAD -- .; then exit 0; else exit 1; fi",
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    { "source": "/_api/:path*", "destination": "https://api.solardoc.app/:path*" },
    { "source": "/p/:id", "destination": "https://api.solardoc.app/p/:id" },
    { "source": "/orc/:codigo", "destination": "https://api.solardoc.app/orc/:codigo" },
    { "source": "/v/:path*", "destination": "https://api.solardoc.app/v/:path*" }
  ],
  "headers": [
    {
      "source": "/((?!_next/static|_next/image|favicon.ico|icons|images).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
