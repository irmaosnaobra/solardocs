# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# ancorado com / so pega a raiz: um `next` rodado de dentro de src/ deixou
# 30 MB em dashboard/src/.next fora do ignore (e dentro do lint) por 34 dias.
**/.next/
**/out/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# saída do preparo da VSL (mp4/jpg pesados, vão pro CDN, nunca pro repo)
/scripts/.vsl-saida/
