# Variaveis do dashboard (Next). Copie para .env.local no seu ambiente.
# Todas NEXT_PUBLIC: vao para o bundle do navegador, entao NAO sao segredo.
# Segredo do dashboard, se houver, fica no painel da Vercel, nunca aqui.
#
# O .gitignore do repo so libera .env.example (este arquivo). O .env.local de
# verdade fica ignorado de proposito. Todas as de checkout tem fallback no
# codigo (src/lib/produtos.ts), entao o app roda sem elas.

# Base da API. Producao: https://api.solardoc.app. Dev: a API local.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Checkouts dos produtos da loja (Kiwify). Um por produto.
NEXT_PUBLIC_KIT_CHECKOUT_URL=
NEXT_PUBLIC_INVENTARIO_CHECKOUT_URL=
NEXT_PUBLIC_PRECIFICACAO_CHECKOUT_URL=
NEXT_PUBLIC_OFFGRID_CHECKOUT_URL=

# LimpaPro: o checkout e o app entregue apos a compra.
NEXT_PUBLIC_LIMPAPRO_CHECKOUT_URL=
NEXT_PUBLIC_LIMPAPRO_APP_URL=

# Liga a oferta de Pix recorrente (Asaas) na tela de pagamento. "1" liga.
NEXT_PUBLIC_PIX_RECORRENTE=
