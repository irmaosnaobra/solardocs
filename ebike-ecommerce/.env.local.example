# ---- Fornecedor (Soollar) --------------------------------------------------
# Sem estas duas, a loja funciona com o PREÇO DE TABELA público e SEM estoque.
# Com elas, passa a usar o preço negociado da conta e a quantidade real do CD.
SOOLLAR_EMAIL=
SOOLLAR_SENHA=
# CD e seção do fornecedor (padrão: Uberlândia / Ebike)
SOOLLAR_CD=cduberlandiamg
SOOLLAR_SECAO=ebike

# ---- Preço -----------------------------------------------------------------
# Margem somada a cada item, em reais.
MARGEM_REAIS=2000

# ---- Acesso ----------------------------------------------------------------
# Senha do /painel (custo, margem e estoque). Sem ela ninguém entra no painel.
PAINEL_SENHA=
# Sal do cookie de sessão do painel. Troque para invalidar todas as sessões.
PAINEL_SAL=irmaos-na-obra-mobilidade
# Com SITE_PRIVADO=1 a loja INTEIRA pede a senha acima (só você vê).
SITE_PRIVADO=1

# ---- Atualização diária ----------------------------------------------------
# Segredo do cron da Vercel (a Vercel injeta no Authorization do agendamento).
CRON_SECRET=
# De quantos em quantos segundos reler o fornecedor (padrão: 1 dia).
CATALOGO_REVALIDA_SEGUNDOS=86400
