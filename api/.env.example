SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
JWT_SECRET=seu_segredo_jwt_aqui_minimo_32_chars
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
# Em produção: URLs separadas por vírgula
# Ex: https://dashboard.vercel.app,https://solardoc.pro
CORS_ORIGIN=http://localhost:3000

# ─── Telemetria e Redis (tudo OPCIONAL) ──────────────────────────────────────
# Sem estas variáveis o código roda igual, só sem o recurso. Nada quebra vazio.

# Sentry — monitoramento de erro. Pegue o DSN em Settings > Client Keys.
SENTRY_DSN=
# Amostragem de performance (0 = só erro; 0.1 = 10% dos requests medidos).
SENTRY_TRACES_SAMPLE_RATE=0

# PostHog — eventos de servidor (venda, lead, agendamento). Chave em
# Project Settings > Project API Key.
POSTHOG_API_KEY=
# Use https://eu.i.posthog.com se o projeto for na União Europeia.
POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis — rate-limit compartilhado do formulário público de indicação.
# Sem as duas, cai no limite em memória (zera a cada cold start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk — login. VAZIO = o login de sempre (JWT próprio), que é o de produção.
# Preencher NÃO troca o login: só habilita aceitar também token do Clerk, e só
# pra usuário já amarrado pela coluna `clerk_user_id` (que ainda não existe).
# A virada de verdade é sessão acompanhada — ver src/middleware/clerkAuth.ts.
CLERK_SECRET_KEY=

# ── Pix RECORRENTE (Asaas) ───────────────────────────────────────────────────
# Não sai pela Stripe: a conta da Aioros é BR e a doc da Stripe é explícita —
# "O Pix Automático não está disponível no Brasil" (conferido na conta em
# 08/08/2026: nem a capability pix_payments existe). Sem ASAAS_API_KEY o trilho
# inteiro fica dark — os endpoints respondem "indisponível" e nada é cobrado.
ASAAS_API_KEY=
# sandbox (padrão, seguro) | prod. Só 'prod' cobra dinheiro de verdade.
ASAAS_ENV=sandbox
# Token que o Asaas devolve no header `asaas-access-token` de cada webhook.
# 32 a 255 caracteres. SEM ele o webhook recusa tudo (fecha por padrão).
ASAAS_WEBHOOK_TOKEN=
# auto (tenta Pix Automático e cai pra assinatura Pix) | automatico | assinatura
ASAAS_PIX_MODO=auto
# Kill-switch: true desliga o Pix recorrente sem tirar a chave.
PIX_RECORRENTE_OFF=
