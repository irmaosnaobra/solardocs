SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
JWT_SECRET=seu_segredo_jwt_aqui_minimo_32_chars
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
# Em produção: URLs separadas por vírgula
# Ex: https://dashboard.vercel.app,https://solardoc.pro
CORS_ORIGIN=http://localhost:3000

# ─── Telemetria e Redis (tudo OPCIONAL) ──────────────────────────────────────
# Sem estas variáveis o código roda igual, só sem o recurso. Nada quebra vazio.

# Sentry — monitoramento de erro. Pegue o DSN em Settings > Client Keys.
SENTRY_DSN=
# Amostragem de performance (0 = só erro; 0.1 = 10% dos requests medidos).
SENTRY_TRACES_SAMPLE_RATE=0

# PostHog — eventos de servidor (venda, lead, agendamento). Chave em
# Project Settings > Project API Key.
POSTHOG_API_KEY=
# Use https://eu.i.posthog.com se o projeto for na União Europeia.
POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis — rate-limit compartilhado do formulário público de indicação.
# Sem as duas, cai no limite em memória (zera a cada cold start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk — login. VAZIO = o login de sempre (JWT próprio), que é o de produção.
# Preencher NÃO troca o login: só habilita aceitar também token do Clerk, e só
# pra usuário já amarrado pela coluna `clerk_user_id` (que ainda não existe).
# A virada de verdade é sessão acompanhada — ver src/middleware/clerkAuth.ts.
CLERK_SECRET_KEY=

# ── Pix RECORRENTE (Asaas) ───────────────────────────────────────────────────
# Não sai pela Stripe: a conta da Aioros é BR e a doc da Stripe é explícita —
# "O Pix Automático não está disponível no Brasil" (conferido na conta em
# 08/08/2026: nem a capability pix_payments existe). Sem ASAAS_API_KEY o trilho
# inteiro fica dark — os endpoints respondem "indisponível" e nada é cobrado.
ASAAS_API_KEY=
# sandbox (padrão, seguro) | prod. Só 'prod' cobra dinheiro de verdade.
ASAAS_ENV=sandbox
# Token que o Asaas devolve no header `asaas-access-token` de cada webhook.
# 32 a 255 caracteres. SEM ele o webhook recusa tudo (fecha por padrão).
ASAAS_WEBHOOK_TOKEN=
# auto (tenta Pix Automático e cai pra assinatura Pix) | automatico | assinatura
ASAAS_PIX_MODO=auto
# Kill-switch: true desliga o Pix recorrente sem tirar a chave.
PIX_RECORRENTE_OFF=

# ── App de Cobranças do /gerador ─────────────────────────────────────────────
# Senha da tela /gerador/cobrancas, que CRIA cobrança de verdade e lista CPF e
# telefone de cliente. Token próprio, separado do CENTRAL_AGENTES_TOKEN: quem
# edita o texto de um robô não é necessariamente quem pode movimentar a conta.
# Sem esta variável o app inteiro responde 503 — é o estado seguro de nascer.
COBRANCA_TOKEN=
# Kill-switch: true trava a criação de cobrança e a antecipação, mas mantém a
# tela e o histórico de pé (tirar o token esconderia a lista junto).
COBRANCA_OFF=

# ── Trello (situação do cliente no Eletroposto) ──────────────────────────────
# NADA AQUI É OBRIGATÓRIO. O quadro de homologação é público, e é assim que o
# insightsService já o lê: board público responde sem key nem token. A rota
# /gerador/trello usa o mesmo id por padrão.
#
# Preencher só se o quadro DEIXAR de ser público (aí a rota passa a assinar a
# chamada) ou pra apontar para outro quadro.
# Chave e token: https://trello.com/power-ups/admin (Power-Up → API key)
TRELLO_KEY=
TRELLO_TOKEN=
# Id do quadro: abra o quadro e acrescente .json na URL — é o campo "id".
# Vazio = 678a89a047242f02d443f8e0 (quadro "Engenheiro Guilherme").
TRELLO_BOARD_ID=

# ── LOJA DE PRODUTOS ────────────────────────────────────────────────────────
# Quem enxerga a loja e os CADEADOS das ferramentas pagas.
# Vazio = todo mundo (é o estado desde 17/08/2026). Pra fechar de novo sem
# deploy, liste os e-mails separados por vírgula; `*` também abre pra todos.
PRODUTOS_BASTIDOR_EMAILS=
# IDs de produto na Kiwify das duas ferramentas do plano anual (R$ 67 cada).
# Sem eles a classificação cai no NOME ("Calculadora Solar" / "Inventário
# Empresarial"), que funciona — mas renomear no painel quebraria o acesso do
# comprador. O id é à prova de renomeação.
PRECIFICACAO_KIWIFY_PRODUCT_IDS=
INVENTARIO_KIWIFY_PRODUCT_IDS=
