{
  "version": 2,
  "ignoreCommand": "P=$VERCEL_GIT_PREVIOUS_SHA; if [ -n \"$P\" ] && { git cat-file -e \"$P^{commit}\" 2>/dev/null || git fetch -q --deepen=300 origin; } && git diff --quiet \"$P\" HEAD -- .; then exit 0; else exit 1; fi",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/cron/master", "schedule": "30 11 * * *" },
    { "path": "/cron/eletroposto-estudo", "schedule": "*/5 * * * *" },
    { "path": "/cron/eletroposto-agenda", "schedule": "*/5 * * * *" },
    { "path": "/cron/eletroposto-top-pontos", "schedule": "0 15 * * *" },
    { "path": "/cron/io-broadcast-tick", "schedule": "*/5 * * * *" },
    { "path": "/cron/eletroposto-reagenda-auto", "schedule": "*/5 * * * *" },
    { "path": "/cron/investidor-agente", "schedule": "*/5 * * * *" },
    { "path": "/cron/sentinela-ferramentas", "schedule": "20 10 * * *" },
    { "path": "/cron/agentes-5040/ensaio", "schedule": "*/5 * * * *" },
    { "path": "/cron/agentes-5040/vivo", "schedule": "*/2 * * * *" },
    { "path": "/cron/agentes-5040/agenda", "schedule": "*/2 * * * *" },
    { "path": "/cron/agentes-5040/base", "schedule": "*/10 * * * *" }
  ]
}
